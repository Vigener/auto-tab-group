{
  "manifest_version": 3,
  "name": "Auto Tab Group",
  "version": "1.0.0",
  "description": "Cmd+クリック等でリンクを開いた際、自動で親タブと同じグループにまとめます（Dia / Zen Browser風）。",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Tab Group 設定"
  }
}
